# MASAKI OS — 環境変数テンプレート（値は入れない。実値は .env.local / Vercel 環境変数へ）

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # サーバー側のみ。公開しない

# --- 認証（Google OAuth） ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
ALLOWED_LOGIN_EMAILS=m.sato@holyday.co.jp   # allowlist（カンマ区切り）

# --- 会議（tl;dv） ---
TLDV_API_KEY=

# --- AI ---
CLAUDE_API_KEY=
AI_PROVIDER=claude            # claude | openai
# OPENAI_API_KEY=

# --- Google Drive ---
GOOGLE_DRIVE_ROOT_FOLDER_ID=  # 議事録等の保存ルート

# --- Cron 保護 ---
CRON_SECRET=                  # Vercel Cron からの呼び出し検証用
